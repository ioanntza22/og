                                       (when filtered-count
                                         (str filtered-count " από "))
                                       total
                                       (if (= total 1) " Συνδεδεμένη αναφορά" " Συνδεδεμένες αναφορές")))
 :unlinked-references/reference-count (fn [total]
                                        (str total
                                         (if (= total 1) " Ασύνδετη αναφορά" " Ασύνδετες αναφορές")))
